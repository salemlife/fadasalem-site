# Copy this file to .env.local for local development (never commit .env.local).
# In Vercel, set the SAME value in two places under Project Settings →
# Environment Variables:
#   1. RPSD_API_KEY        (used server-side by api/rpsd-upload.ts and api/rpsd-delete.ts)
#   2. VITE_RPSD_API_KEY    (used client-side, baked into the build by Vite)
# Pick any long random string — it just has to match in both places.
VITE_RPSD_API_KEY=change-me-to-a-long-random-string
